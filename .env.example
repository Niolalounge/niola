# Copy to .env and fill in. Both values come from:
# Supabase Dashboard -> Project Settings -> API
#
# The anon key is a PUBLIC key: it is compiled into the browser bundle by design.
# Data is protected by Row Level Security in the database, not by hiding this key.
# Never put the service_role key in a VITE_ variable — that key bypasses RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
